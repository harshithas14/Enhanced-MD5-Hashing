<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>EnhancedMD5Auth</RootNamespace>
    <AssemblyName>EnhancedMD5Auth</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <LangVersion>12</LangVersion>
    <ApplicationIcon />
    <StartupObject>EnhancedMD5Auth.Program</StartupObject>
    <Description>Enhanced MD5 Authentication — Salting, Peppering and Iterative Strengthening</Description>
    <Authors>EnhancedMD5Auth</Authors>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- No third-party NuGet packages required — uses only BCL crypto APIs -->

</Project>
